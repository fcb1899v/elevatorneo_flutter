# Template for assets/.env, which is untracked. Copy this to that name and fill
# in the values. pubspec.yaml lists assets/.env, so the file has to exist or the
# build fails; this template is not listed and is not bundled.
#
# Named with an underscore, not .env.example: the repository's Claude Code
# settings deny Edit(**/.env.*), so a dotted name could not be maintained here.
#
# Everything here ships inside the release bundle. Verified 2026-09-05 by
# unzipping an AAB and finding assets/.env intact. These values are therefore
# identifiers, not secrets: an AdMob unit id is sent with every ad request and a
# leaderboard id is sent to Play Games. Nothing that grants access belongs here.

# Firebase project number, used to build the Play Games sign-in request.
PROJECT_NUMBER=

# AdMob banner. Real ids, used in release builds. Debug builds use Google's
# INLINE ADAPTIVE demo units, which differ from the fixed-size ones:
#   Android  ca-app-pub-3940256099942544/9214589741
#   iOS      ca-app-pub-3940256099942544/2435281174
IOS_BANNER_UNIT_ID=
ANDROID_BANNER_UNIT_ID=

# AdMob rewarded.
IOS_REWARDED_UNIT_ID=
ANDROID_REWARDED_UNIT_ID=

# Game Center / Play Games leaderboard.
ANDROID_LEADERBOARD_ID=
IOS_LEADERBOARD_ID=
