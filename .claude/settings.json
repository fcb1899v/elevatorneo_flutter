{
  "permissions": {
    "deny": [
      "Read(**/key.properties)",
      "Edit(**/key.properties)",
      "Write(**/key.properties)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Write(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Write(**/*.keystore)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.mobileprovision)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Read(**/*service-account*.json)",
      "Read(**/google-services.json)",
      "Read(**/GoogleService-Info.plist)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Bash(cat *key.properties*)",
      "Bash(cat *.env*)",
      "Bash(head *key.properties*)",
      "Bash(head *.env*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(fastlane:*)",
      "Bash(firebase deploy:*)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)"
    ]
  }
}
